{
  "name": "querymedic-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "QueryMedic — AI-powered database performance doctor",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @querymedic/api run dev",
    "dev:workers": "pnpm --filter @querymedic/workers run dev",
    "dev:web": "pnpm --filter @querymedic/web run dev",
    "db:generate": "pnpm --filter @querymedic/database run generate",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
