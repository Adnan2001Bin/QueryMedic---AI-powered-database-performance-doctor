datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ENGINEER
  VIEWER
}

enum DatabaseEngine {
  POSTGRESQL
  MYSQL
}

enum ConnectionMode {
  DIRECT
  AGENT
}

enum ConnectionStatus {
  ONLINE
  OFFLINE
  DEGRADED
  AGENT_DISCONNECTED
  EXTENSION_MISSING
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingStatus {
  DETECTED
  RESOLVED
  MUTED
}

enum RecommendationStatus {
  DETECTED
  ANALYZED
  RECOMMENDED
  TESTING
  VERIFIED
  APPROVED
  APPLIED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RemediationType {
  CREATE_INDEX
  DROP_INDEX
  REWRITE_QUERY
  VACUUM
  CONFIG_CHANGE
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  planTier            String               @default("developer")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  members             OrganizationMember[]
  databaseConnections DatabaseConnection[]
  auditLogs           AuditLog[]
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  approvedRecommendations Recommendation[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model DatabaseConnection {
  id                String             @id @default(uuid())
  organizationId    String
  name              String
  engine            DatabaseEngine     @default(POSTGRESQL)
  host              String
  port              Int                @default(5432)
  databaseName      String
  username          String
  encryptedPassword String             // AES-256-GCM
  passwordIv        String             // Base64 IV
  passwordTag       String             // Base64 Auth Tag
  sslMode           String             @default("prefer")
  connectionMode    ConnectionMode     @default(DIRECT)
  agentToken        String?            @unique
  status            ConnectionStatus   @default(ONLINE)
  healthScore       Int                @default(100)
  lastScannedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots         DatabaseSnapshot[]
  normalizedQueries NormalizedQuery[]
  findings          Finding[]
  alertConfigs      AlertConfiguration[]
  alertEvents       AlertEvent[]
}

model DatabaseSnapshot {
  id                 String             @id @default(uuid())
  databaseId         String
  totalSizeBytes     BigInt
  cacheHitRatio      Float
  activeConnections  Int
  maxConnections     Int
  longestTxDurationSec Float             @default(0)
  createdAt          DateTime           @default(now())

  database           DatabaseConnection @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  tableCatalogs      TableCatalog[]
  indexCatalogs      IndexCatalog[]
}

model TableCatalog {
  id              String           @id @default(uuid())
  snapshotId      String
  schemaName      String           @default("public")
  tableName       String
  liveTuples      BigInt           @default(0)
  deadTuples      BigInt           @default(0)
  tableSizeBytes  BigInt           @default(0)
  indexSizeBytes  BigInt           @default(0)

  snapshot        DatabaseSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model IndexCatalog {
  id              String           @id @default(uuid())
  snapshotId      String
  schemaName      String           @default("public")
  tableName       String
  indexName       String
  columns         String[]
  isUnique        Boolean          @default(false)
  indexSizeBytes  BigInt           @default(0)
  idxScanCount    BigInt           @default(0)

  snapshot        DatabaseSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model NormalizedQuery {
  id               String             @id @default(uuid())
  databaseId       String
  queryFingerprint String             // Deterministic SHA-256
  normalizedSql    String             // Parameters replaced with $1, $2 or ?
  mainTable        String?
  statementType    String             @default("SELECT")
  firstSeenAt      DateTime           @default(now())
  lastSeenAt       DateTime           @default(now())

  database         DatabaseConnection @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  metrics          QueryMetric[]
  findings         Finding[]

  @@unique([databaseId, queryFingerprint])
}

model QueryMetric {
  id               String          @id @default(uuid())
  queryId          String
  calls            BigInt          @default(0)
  totalExecTimeMs  Float           @default(0)
  meanExecTimeMs   Float           @default(0)
  p95ExecTimeMs    Float           @default(0)
  rowsProcessed    BigInt          @default(0)
  sharedBlksHit    BigInt          @default(0)
  sharedBlksRead   BigInt          @default(0)
  impactScore      Float           @default(0)
  snapshotAt       DateTime        @default(now())

  query            NormalizedQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model Finding {
  id                    String             @id @default(uuid())
  databaseId            String
  queryId               String?
  ruleCode              String             // e.g. RULE-SCAN-01, RULE-IDX-01
  findingType           String             // SEQUENTIAL_SCAN, MISSING_INDEX, etc.
  severity              FindingSeverity    @default(MEDIUM)
  status                FindingStatus      @default(DETECTED)
  deterministicEvidence Json               // Structured facts from AST & plan
  createdAt             DateTime           @default(now())
  resolvedAt            DateTime?

  database              DatabaseConnection @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  query                 NormalizedQuery?   @relation(fields: [queryId], references: [id], onDelete: SetNull)
  recommendation        Recommendation?
}

model Recommendation {
  id               String                    @id @default(uuid())
  findingId        String                    @unique
  title            String
  rootCause        String
  explanation      String
  remediationType  RemediationType           @default(CREATE_INDEX)
  recommendedSql   String
  riskLevel        RiskLevel                 @default(LOW)
  riskExplanation  String
  estimatedMinPct  Float                     @default(0)
  estimatedMaxPct  Float                     @default(0)
  verifiedPct      Float?
  status           RecommendationStatus      @default(RECOMMENDED)
  approvedByUserId String?
  appliedAt        DateTime?
  rejectionReason  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  finding          Finding                   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  approvedBy       User?                     @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  benchmarks       RecommendationBenchmark[]
}

model RecommendationBenchmark {
  id                  String         @id @default(uuid())
  recommendationId    String
  environmentType     String         @default("SANDBOX")
  baselineLatencyMs   Float
  baselinePlanSummary String
  testLatencyMs       Float
  testPlanSummary     String
  improvementPct      Float
  baselinePlanJson    Json
  testPlanJson        Json
  executedAt          DateTime       @default(now())

  recommendation      Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

model AlertConfiguration {
  id               String             @id @default(uuid())
  databaseId       String
  channelType      String             // SLACK, DISCORD, WEBHOOK, EMAIL
  destinationUrl   String
  minSeverity      FindingSeverity    @default(HIGH)
  isEnabled        Boolean            @default(true)
  createdAt        DateTime           @default(now())

  database         DatabaseConnection @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

model AlertEvent {
  id               String             @id @default(uuid())
  databaseId       String
  alertType        String             // LATENCY_REGRESSION, CONNECTION_POOL_SATURATION
  severity         FindingSeverity
  summary          String
  payload          Json
  dispatchedAt     DateTime           @default(now())
  deliveryStatus   String             @default("SENT")

  database         DatabaseConnection @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  userId         String?
  actionType     String        // APPLY_INDEX, REJECT_RECOMMENDATION, CONNECT_DATABASE, etc.
  targetEntity   String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}
